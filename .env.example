# --- Discord ---
DISCORD_TOKEN=your-discord-bot-token
COMMAND_PREFIX=!
ENABLE_BOT=true

# --- Database ---
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mico
# SQLite (development/fallback):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mico
# --- FastAPI Web Server ---
ENABLE_API=true
API_HOST=127.0.0.1
API_PORT=8000

# --- AI provider ---
# One of: gemini, groq, openai, openrouter
AI_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
# Tried in order if the primary model returns a 503/5xx (e.g. overloaded).
GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-1.5-flash-8b

# --- Groq (OpenAI-compatible) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenAI-compatible (OpenAI / OpenRouter) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_FALLBACK_MODELS=
# OPENAI_BASE_URL=   # set this for OpenRouter, leave unset for OpenAI

# --- Agent behavior ---
MAX_HISTORY_MESSAGES=20

# --- Automation ---
# Polling interval for reminders and scheduled summaries.
AUTOMATION_CHECK_INTERVAL_SECONDS=3

# --- GitHub Integration ---
# GITHUB_TOKEN=ghp_yourpersonalaccesstoken
GITHUB_DEFAULT_USER=akosimico
# Configure these in GitHub's webhook settings for push, issues, and pull-request notifications.
# GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# GITHUB_WEBHOOK_CHANNEL_ID=your-discord-channel-id

# --- Misc ---
LOG_LEVEL=INFO
