# --- Discord ---
DISCORD_TOKEN=your-discord-bot-token
COMMAND_PREFIX=!
ENABLE_BOT=true

# --- Database ---
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mico
# SQLite (development/fallback):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mico
# Required by docker-compose.yml; use a long unique value in production.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# --- FastAPI Web Server ---
ENABLE_API=true
API_HOST=127.0.0.1
API_PORT=8000

# --- AI provider ---
# One of: gemini, groq, openai, openrouter
AI_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
# Fallback model optimized for high-throughput, low-latency agent tasks
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# --- Groq (OpenAI-compatible) ---
# Optional automatic failover when Gemini free-tier quota is exhausted.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenAI-compatible (OpenAI / OpenRouter) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_FALLBACK_MODELS=
# OPENAI_BASE_URL=   # set this for OpenRouter, leave unset for OpenAI

# --- Voice (requires OPENAI_API_KEY) ---
VOICE_ENABLED=false
VOICE_STT_MODEL=gpt-4o-mini-transcribe
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=alloy

# --- Agent behavior ---
MAX_HISTORY_MESSAGES=20

# --- Automation ---
# Polling interval for reminders and scheduled summaries.
AUTOMATION_CHECK_INTERVAL_SECONDS=3
MONITOR_REQUEST_TIMEOUT_SECONDS=10

# --- Local PC Agent ---
# All local file and Git actions are confined to this directory. Applications must be explicitly allowlisted.
PC_WORKSPACE_ROOT=.
# PC_ALLOWED_APPLICATIONS=code,notepad

# --- GitHub Integration ---
# GITHUB_TOKEN=ghp_yourpersonalaccesstoken
GITHUB_DEFAULT_USER=akosimico
# Configure these in GitHub's webhook settings for push, issues, and pull-request notifications.
# GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# GITHUB_WEBHOOK_CHANNEL_ID=your-discord-channel-id

# --- Misc ---
LOG_LEVEL=INFO
