# Mico Core local configuration
# Copy this file to .env, then set DISCORD_TOKEN and one AI provider API key.

# --- Required: Discord ---
DISCORD_TOKEN=your-discord-bot-token
COMMAND_PREFIX=!
ENABLE_BOT=true

# --- Required: local database ---
# SQLite needs no separate database server and is recommended for local use.
DATABASE_URL=sqlite+aiosqlite:///./mico.db

# --- FastAPI Web Server ---
ENABLE_API=true
API_HOST=127.0.0.1
API_PORT=8000

# --- Required: AI provider ---
# One of: gemini, groq, openai, openrouter
AI_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Fallback model optimized for high-throughput, low-latency agent tasks
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite

# --- Optional: Groq (OpenAI-compatible) ---
# Set AI_PROVIDER=groq to use Groq directly. A configured key also enables
# automatic Gemini quota fallback.
# GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Optional: OpenAI or OpenRouter ---
# Set AI_PROVIDER=openai for OpenAI, or AI_PROVIDER=openrouter and set its base URL.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_FALLBACK_MODELS=
# OPENAI_BASE_URL=   # set this for OpenRouter, leave unset for OpenAI

# --- Optional: Voice (requires OPENAI_API_KEY) ---
VOICE_ENABLED=false
VOICE_STT_MODEL=gpt-4o-mini-transcribe
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=alloy

# --- Agent behavior ---
MAX_HISTORY_MESSAGES=20

# --- Optional: Automation and monitoring ---
# Polling interval for reminders and scheduled summaries.
AUTOMATION_CHECK_INTERVAL_SECONDS=3
MONITOR_REQUEST_TIMEOUT_SECONDS=10

# --- Optional: Local PC Agent ---
# All local file and Git actions are confined to this directory. Applications must be explicitly allowlisted.
PC_WORKSPACE_ROOT=.
# PC_ALLOWED_APPLICATIONS=code,notepad

# --- Optional: GitHub integration ---
# GITHUB_TOKEN=your-github-personal-access-token
# GITHUB_DEFAULT_USER=your-github-username
# Configure these in GitHub's webhook settings for push, issues, and pull-request notifications.
# GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
# GITHUB_WEBHOOK_CHANNEL_ID=your-discord-channel-id

# --- Docker / PostgreSQL only ---
# Docker Compose overrides DATABASE_URL. Set this to a long, unique password
# before running `docker compose up --build`.
# POSTGRES_PASSWORD=replace-with-a-long-random-password

# --- Misc ---
LOG_LEVEL=INFO
